# 验证企业微信回调的token
WEWORK_TOKEN="XXXXXXXXXXX"
# 验证企业微信回调的key
WEWORK_ENCODING_AES_KEY="XXXXXXXXXXX"
# 企业微信企业id
WEWORK_CORPID="XXXXXXXXXXX"
# 企业微信secret
WEWORK_CORPSECRET="XXXXXXXXXXX"
# openai key
OPENAI_API_KEY="XXXXXXXXXXX"
# coze 工作流相关配置
COZE_PAT=XXXXXXXXXXX
COZE_BOT_ID=XXXXXXXXXXX
COZE_WORKFLOW_ID=XXXXXXXXXXX
COZE_APP_ID=XXXXXXXXXXX
# ✅ 新配置（必须改成服务名）
# DB_HOST=db
# REDIS_HOST=redis
# MYSQL 数据库配置
DB_USER="root"
DB_PASSWORD="XXXXXXXXXXX"
DB_HOST=mysql      # ✅ 注意：这里写 docker 服务名 "mysql"，不是 localhost
DB_PORT="3306"
DB_NAME="conversation_history"
# Redis 配置
REDISHOST=redis   # ✅ 注意：这里写 docker 服务名 "redis"
REDISPORT="6379"
REDIS_DB="0"
REDIS_PASSWORD="XXXXXXXXXXX"

# 第三方个人微信 Gewe（发送文字等，见 docs/发送文字消息.md）
GEWE_API_BASE="http://api.geweapi.com"
GEWE_TOKEN="XXXXXXXXXXX"
# 个人微信回调：仅处理来自这些好友 wxid 的 AddMsg（英文逗号分隔）；留空则不限制
# TPW_FROM_WXID_WHITELIST="wxid_aaa,wxid_bbb"
# 企微下载媒体后拼公网 URL 用（个人微信媒体走 Gewe 临时链接直传 Coze，可不配）
SERVER_BASE_URL="https://your-domain.com"